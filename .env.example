# RPC endpoint for the network you want to use (Sepolia example)
RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# Private key of the account that will deploy and run the bot (keep secret!)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Cold wallet that will receive profits (address only, never store its private key here)
COLD_WALLET=0xYOUR_COLD_WALLET_ADDRESS
# Amount of ETH (in wei) to keep in the contract for future gas fees
GAS_RESERVE=10000000000000000  # 0.01 ETH

# Aave LendingPoolAddressesProvider for the chosen network
AAVE_PROVIDER=0x....

# Uniswap V2 router address (Sepolia uses the same address as mainnet)
UNISWAP_ROUTER=0x7a250d5630B4cF539739dF2C5dAcb4c659F2488D

# Sushiswap router address
SUSHISWAP_ROUTER=0xd9e1cE17f2641f24aE83637ab66a2cca9C378B9F

# Token you will borrow / trade (e.g., DAI)
DAI_TOKEN=0x6B175474E89094C44Da98b954EedeAC495271d0F
